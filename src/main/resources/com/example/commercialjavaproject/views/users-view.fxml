<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="25.0" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.commercialjavaproject.UsersController">
    <children>

        <!-- ================= HEADER ================= -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="User Directory" textFill="#0F172A">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label text="Manage your team members and their account permissions here." textFill="#64748B" style="-fx-font-size: 13px;" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="addUserBtn" onAction="#showAddForm" text="+ Add User" prefHeight="40.0" style="-fx-background-color: #4F46E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 25 0 25; -fx-effect: dropshadow(three-pass-box, rgba(79,70,229,0.3), 10, 0, 0, 4);" />
            </children>
        </HBox>

        <!-- ================= SEARCH & FILTER BAR ================= -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <TextField fx:id="searchField" promptText="🔍 Search users by name or email..." prefHeight="42.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 15 0 15; -fx-font-size: 14px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 5, 0, 0, 2);" />
                <ComboBox fx:id="roleFilterCombo" promptText="Filter by Role" prefHeight="42.0" prefWidth="160.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px;" />
            </children>
        </HBox>

        <!-- ================= DATA TABLE ================= -->
        <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 20, 0, 0, 8);">
            <children>
                <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 12 12 0 0; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colFirstName" text="User" />
                        <TableColumn fx:id="colLastName" text="Last Name" />
                        <TableColumn fx:id="colEmail" text="Email Address" />
                        <TableColumn fx:id="colRole" text="Role" />
                        <TableColumn fx:id="colStatus" text="Status" />
                        <TableColumn fx:id="colActions" text="Actions" style="-fx-alignment: CENTER;" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Pagination Footer -->
                <HBox alignment="CENTER_RIGHT" spacing="20.0" style="-fx-padding: 15 25 15 25; -fx-border-color: #F1F5F9 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                    <children>
                        <Label fx:id="pageInfoLabel" text="Showing 1 to 10 of 50 entries" textFill="#94A3B8" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="prevBtn" onAction="#prevPage" text="Previous" prefHeight="34.0" prefWidth="90.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 12px; -fx-cursor: hand;" />
                        <Button fx:id="nextBtn" onAction="#nextPage" text="Next" prefHeight="34.0" prefWidth="90.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 12px; -fx-cursor: hand;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>