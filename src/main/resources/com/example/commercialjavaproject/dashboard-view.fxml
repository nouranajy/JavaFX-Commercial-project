<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="Infinity" maxWidth="Infinity" prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.commercialjavaproject.DashboardController">
    <children>

        <!-- SIDEBAR -->
        <VBox prefWidth="250.0" spacing="20.0" style="-fx-background-color: #102A43;">
            <padding>
                <Insets top="30.0" bottom="30.0" left="20.0" right="20.0" />
            </padding>
            <children>
                <Label text="NEXUS" textFill="WHITE" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 0 0 20 0;" />

                <Button text="Dashboard" prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: #1a3c5a; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 6; -fx-cursor: hand;" />
                <Button text="My Profile" prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: transparent; -fx-text-fill: #A0B3C6; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-cursor: hand;" />
                <Button text="Settings" prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: transparent; -fx-text-fill: #A0B3C6; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-cursor: hand;" />

                <!-- Spacer to push logout to bottom -->
                <VBox VBox.vgrow="ALWAYS" />

                <Button fx:id="logoutButton" onAction="#handleLogout" text="Logout" prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
            </children>
        </VBox>

        <!-- MAIN CONTENT -->
        <VBox HBox.hgrow="ALWAYS" spacing="20.0">
            <padding>
                <Insets top="40.0" right="40.0" bottom="40.0" left="40.0" />
            </padding>
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Dashboard" textFill="#102A43">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                    </children>
                </HBox>

                <!-- User Info Card -->
                <VBox maxWidth="600.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 30;">
                    <children>
                        <Label text="Welcome to your workspace!" textFill="#102A43">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>

                        <HBox spacing="10.0">
                            <children>
                                <Label text="Name:" textFill="#627D98" style="-fx-font-weight: bold;" />
                                <Label fx:id="userNameLabel" text="Loading..." textFill="#334E68" />
                            </children>
                        </HBox>

                        <HBox spacing="10.0">
                            <children>
                                <Label text="Email:" textFill="#627D98" style="-fx-font-weight: bold;" />
                                <Label fx:id="userEmailLabel" text="Loading..." textFill="#334E68" />
                            </children>
                        </HBox>

                        <HBox spacing="10.0">
                            <children>
                                <Label text="Role:" textFill="#627D98" style="-fx-font-weight: bold;" />
                                <Label fx:id="userRoleLabel" text="Loading..." textFill="#334E68" style="-fx-background-color: #E3F2FD; -fx-padding: 2 8; -fx-background-radius: 4;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>

    </children>
</HBox>