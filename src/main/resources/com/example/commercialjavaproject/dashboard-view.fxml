<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="Infinity" maxWidth="Infinity" prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F4F6F8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.commercialjavaproject.DashboardController">
    <children>

        <!-- ================= TOP UTILITY BAR ================= -->
        <HBox alignment="CENTER_LEFT" prefHeight="30.0" style="-fx-background-color: #0F172A; -fx-padding: 0 20 0 20;">
            <children>
                <Label text="Enterprise Management System" textFill="#94A3B8" style="-fx-font-size: 10px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="System Status: " textFill="#94A3B8" style="-fx-font-size: 10px;" />
                <Label text="● Online" textFill="#10B981" style="-fx-font-size: 10px; -fx-font-weight: bold;" />
            </children>
        </HBox>

        <!-- ================= MAIN APPLICATION AREA ================= -->
        <HBox VBox.vgrow="ALWAYS">
            <children>

                <!-- ================= SIDEBAR ================= -->
                <VBox fx:id="sidebarContainer" prefWidth="250.0" spacing="0.0" style="-fx-background-color: #102A43; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 5, 0);">
                    <children>
                        <!-- Sidebar Brand & Hamburger -->
                        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="10.0" style="-fx-padding: 0 0 0 10;">
                            <children>
                                <Button fx:id="menuToggleBtn" onAction="#toggleSidebar" text="☰" style="-fx-background-color: transparent; -fx-font-size: 20px; -fx-cursor: hand; -fx-text-fill: #FFFFFF;" />
                                <ImageView fx:id="sidebarLogo" fitHeight="38.0" fitWidth="38.0" preserveRatio="true">
                                    <image>
                                        <Image url="@/com/example/commercialjavaproject/logo.png" />
                                    </image>
                                </ImageView>
                                <Label fx:id="sidebarBrandLabel" text="NAJYGRID" textFill="#FFFFFF" style="-fx-font-size: 18px; -fx-font-weight: 900;" />
                            </children>
                        </HBox>

                        <!-- Scrollable Sidebar Navigation -->
                        <ScrollPane fx:id="sidebarScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                            <content>
                                <VBox spacing="5.0" style="-fx-background-color: transparent; -fx-padding: 20 10 20 10;">
                                    <children>
                                        <Button fx:id="dashboardBtn" onAction="#showDashboard" text="📊   Dashboard" prefHeight="45.0" maxWidth="Infinity" style="-fx-background-color: #1A3C5A; -fx-text-fill: #FFFFFF; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" />
                                        <Button fx:id="productsBtn" onAction="#showProducts" text="📦   Products" prefHeight="45.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-font-size: 14px; -fx-cursor: hand;" />
                                        <Button fx:id="ordersBtn" onAction="#showOrders" text="🛒   Orders" prefHeight="45.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-font-size: 14px; -fx-cursor: hand;" />
                                        <Button fx:id="usersBtn" onAction="#showUsers" text="👥   Manage Users" prefHeight="45.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-font-size: 14px; -fx-cursor: hand;" />
                                        <Button fx:id="settingsBtn" onAction="#showSettings" text="⚙️   Settings" prefHeight="45.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-font-size: 14px; -fx-cursor: hand;" />
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- Elegant Logout Button -->
                        <VBox style="-fx-padding: 0 15 15 15;">
                            <children>
                                <Button fx:id="logoutButton" onAction="#handleLogout" text="Sign out" prefHeight="40.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: #334E68; -fx-border-radius: 6; -fx-text-fill: #A0B3C6; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" />
                            </children>
                        </VBox>

                        <!-- Sidebar Footer -->
                        <HBox alignment="CENTER" prefHeight="50.0" style="-fx-border-color: #1A3C5A transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                            <children>
                                <Label fx:id="sidebarFooterLabel" text="v1.0.0 (Enterprise)" textFill="#64748B" style="-fx-font-size: 11px;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- ================= RIGHT SIDE ================= -->
                <VBox HBox.hgrow="ALWAYS">
                    <children>

                        <!-- MAIN HEADER -->
                        <HBox alignment="CENTER" prefHeight="60.0" style="-fx-background-color: #FFFFFF; -fx-border-color: transparent transparent #E2E8F0 transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 30 0 30;" spacing="25.0">
                            <children>
                                <Label text="Overview" textFill="#102A43" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />
                                <Label text="Reports" textFill="#64748B" style="-fx-font-size: 14px; -fx-cursor: hand;" />
                                <Label text="Analytics" textFill="#64748B" style="-fx-font-size: 14px; -fx-cursor: hand;" />
                                <Label text="Support" textFill="#64748B" style="-fx-font-size: 14px; -fx-cursor: hand;" />

                                <Region HBox.hgrow="ALWAYS" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="👤" style="-fx-font-size: 24px; -fx-text-fill: #102A43;" />
                                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                                            <children>
                                                <Label fx:id="headerUserNameLabel" text="User Name" textFill="#102A43" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                                                <Label fx:id="headerUserEmailLabel" text="user@email.com" textFill="#64748B" style="-fx-font-size: 11px;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- DYNAMIC SUBHEADER (Reduced height to 55px) -->
                        <HBox alignment="CENTER_LEFT" prefHeight="55.0" style="-fx-background-color: #FFFFFF; -fx-border-color: transparent transparent #E2E8F0 transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 30 0 30;" spacing="15.0">
                            <children>
                                <Label fx:id="welcomeLabel" text="Welcome back, User Name" textFill="#0F172A" style="-fx-font-size: 18px; -fx-font-weight: 900;" />
                                <Label text="|" textFill="#CBD5E1" style="-fx-font-size: 14px;" />
                                <Label fx:id="breadcrumbLabel" text="Home / Dashboard Overview" textFill="#94A3B8" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                            </children>
                        </HBox>

                        <!-- DYNAMIC SCROLLABLE CONTENT AREA -->
                        <ScrollPane fx:id="contentScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" style="-fx-background-color: #F4F6F8; -fx-background: #F4F6F8; -fx-border-color: transparent;">
                            <content>
                                <StackPane fx:id="contentArea" style="-fx-padding: 40;">
                                    <children>
                                        <VBox maxWidth="800.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 15, 0, 0, 5); -fx-padding: 35;">
                                            <children>
                                                <Label text="Your Workspace Overview" textFill="#102A43">
                                                    <font><Font name="System Bold" size="20.0" /></font>
                                                </Label>
                                                <HBox spacing="15.0">
                                                    <children>
                                                        <Label text="Full Name" textFill="#64748B" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                                                        <Label fx:id="userNameLabel" text="Loading..." textFill="#102A43" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                                                    </children>
                                                </HBox>
                                                <HBox spacing="15.0">
                                                    <children>
                                                        <Label text="Email Address" textFill="#64748B" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                                                        <Label fx:id="userEmailLabel" text="Loading..." textFill="#102A43" style="-fx-font-size: 14px;" />
                                                    </children>
                                                </HBox>
                                                <HBox spacing="15.0">
                                                    <children>
                                                        <Label text="System Role" textFill="#64748B" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                                                        <Label fx:id="userRoleLabel" text="Loading..." textFill="#1D4ED8" style="-fx-background-color: #DBEAFE; -fx-padding: 4 10; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </StackPane>
                            </content>
                        </ScrollPane>

                        <!-- FOOTER -->
                        <HBox alignment="CENTER" prefHeight="40.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                            <children>
                                <Label text="© 2026 NAJYGRID Enterprise. All rights reserved." textFill="#94A3B8" style="-fx-font-size: 11px;" />
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>